global
    log stdout format raw local0 info
    maxconn 4096

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms

frontend http_in
    bind :80
    # Redirect all plain HTTP traffic to HTTPS
    redirect scheme https code 301 if !{ ssl_fc }

frontend https_in
    # Bind to port 443 terminating SSL/TLS with our generated certificate
    bind :443 ssl crt /usr/local/etc/haproxy/certs/haproxy.pem
    
    # Secure HTTP Headers Injection
    http-request set-header X-Forwarded-Proto https if { ssl_fc }
    http-request set-header X-Real-IP %[src]
    option forwardfor

    default_backend app_servers

backend app_servers
    balance roundrobin
    option httpchk GET /
    http-check expect status 200
    
    # Point to the container name of Caddy inside 'dmz-net'
    # 'check' enables automated, periodic health monitoring on port 80
    server caddy-srv1 caddy-srv1:80 check inter 2000 fall 3 rise 2
